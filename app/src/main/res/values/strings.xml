    <!-- Disclaimer -->
    <string name="disclaimer_title">জরুরি কথা</string>
    <string name="disclaimer_body">“পাশে” শুধু ওষুধ মনে করিয়ে দেওয়ার একটি সহায়ক অ্যাপ। এটি কোনো চিকিৎসা পরামর্শ দেয় না।\n\nকোন ওষুধ, কতটুকু এবং কখন খাবেন — সবসময় ডাক্তারের পরামর্শ মেনে চলুন। ওষুধের নাম বা সময় ভুল লেখা হলে অ্যাপ সেটা বুঝতে পারবে না, তাই সাবধানে তথ্য দিন।\n\nজরুরি অবস্থায় দেরি না করে ডাক্তার বা নিকটস্থ হাসপাতালে যোগাযোগ করুন।</string>
